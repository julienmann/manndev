# systemd unit for the client portal API. Install steps: portal-src/SETUP.md §4.
[Unit]
Description=Mann Dev client portal API (password changes)
After=network.target

[Service]
User=lmann
ExecStart=/usr/bin/python3 /srv/www/manndev/portal-src/server/portal_api.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/www/manndev/client-files

[Install]
WantedBy=multi-user.target
